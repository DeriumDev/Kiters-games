{
  "redirects": [
    {
      "source": "/",
      "destination": "https://deriumdev.github.io/Kiters-games/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    }
  ]
}
